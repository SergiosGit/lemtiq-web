		}
	],
	"vars": {
		"ACCESS_ISSUER": "https://sparkling-glitter-d6e2.cloudflareaccess.com",
		"ACCESS_AUD": "47ffc741eccd381ca7849e7b847183afd2f3f6ee79630c7332543bee583e44fa",
		"ADMIN_EMAIL": "weakinteraction@gmail.com",
		"FAMILY_ACCESS_AUD": "a21c7357b58d65d545cc31deaf6e301e760925b31492bea8608b09de6b8bbd6a"
	}
